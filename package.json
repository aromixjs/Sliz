{
  "name": "sliz",
  "version": "0.0.1",
  "description": "Sliz Compiler",
  "keywords": [
    "aromix",
    "core",
    "framework",
    "node",
    "rpc",
    "server"
  ],
  "homepage": "https://aromixjs.github.io/aromix",
  "bugs": {
    "url": "https://github.com/aromixjs/aromix/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aromixjs/aromix.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "change": "beachball change",
    "bump": "beachball bump",
    "release": "beachball publish --yes --access public",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "acorn": "^8.18.0",
    "acorn-loose": "^8.5.2",
    "acorn-walk": "^8.3.5",
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.26.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vue/compiler-core": "^3.5.41",
    "beachball": "^2.65.5",
    "fast-check": "^4.9.0",
    "htmlparser2": "^12.0.0",
    "oxfmt": "^0.63.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.11",
    "vitest": "^4.1.6"
  }
}
