{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ESNext"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {}
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "playground/**/*.ts",
    "tests/**/*.ts",
    "demo/**/*.ts"
  ]
}
